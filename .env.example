DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_PRELOAD=False

# Leave DB_ENGINE unset for a zero-configuration SQLite development database.
# Set DB_ENGINE=mysql and the values below to use MySQL.
DB_ENGINE=
DB_NAME=online_test_platform
DB_USER=otp_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Optional isolated code-execution service. Without this endpoint,
# coding submissions are explicitly marked unavailable and are not scored.
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
